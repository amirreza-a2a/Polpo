# ============================================================
#  PolpoT Configuration Template (.env.example)
# ============================================================

# ─── Telegram Bot ───────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321
BACKUP_CHANNEL_ID=-1001234567890
SOURCE_ARCHIVE_CHANNEL_ID=-1001234567890

# ─── Database MySQL ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=polpot_db
DB_USER=polpot_user
DB_PASS=your_db_password_here

# ─── Limits & Thresholds ────────────────────────────────────
MAX_PDF_SIZE_MB=100
DAILY_PAGE_LIMIT=100
MAX_QUEUE_PER_USER=3
DPI=200

# ─── Storage & Runtime Paths (Relative to project root by default) ───
TEMP_DIR=temp_files
OUTPUT_DIR=output_files
WORKER_LOCK_FILE=worker.lock
RATE_FILE=rate_limits.json
